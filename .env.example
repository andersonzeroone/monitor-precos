# Copie para .env e preencha só o que for usar.

# Painel
PORT=3000
# HOST=127.0.0.1         # padrão: só acessível neste computador
# Para abrir na rede/servidor use HOST=0.0.0.0 e OBRIGATORIAMENTE defina uma senha:
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=troque-esta-senha

# Fuso usado nos horários e nas janelas (padrão: America/Sao_Paulo)
# TZ=America/Sao_Paulo

# Banco de dados (padrão: data/monitor.db)
# DB_FILE=data/monitor.db

# --- WhatsApp: escolha o provedor no painel e preencha as variáveis dele ---

# CallMeBot: não precisa de nada aqui (a apikey vai em cada número, no painel).

# Evolution API (seu próprio número conectado por QR code)
# EVOLUTION_URL=https://sua-evolution-api.com
# EVOLUTION_APIKEY=
# EVOLUTION_INSTANCE=minha-instancia

# WhatsApp Cloud API (oficial da Meta)
# WA_CLOUD_TOKEN=
# WA_CLOUD_PHONE_ID=
# WA_CLOUD_API_VERSION=v23.0
